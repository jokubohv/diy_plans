          <baseName><simpleValue>partId</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Expected IfcVirtualElement products" ifcVersion="IFC4X3_ADD2">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IfcVirtualElement</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name><simpleValue>GlobalId</simpleValue></name>
        </attribute>
        <property cardinality="required">
          <propertySet><simpleValue>Pset_DiyGuide</simpleValue></propertySet>
          <baseName><simpleValue>partId</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Expected IfcWall products" ifcVersion="IFC4X3_ADD2">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IfcWall</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name><simpleValue>GlobalId</simpleValue></name>
        </attribute>
        <property cardinality="required">
          <propertySet><simpleValue>Pset_DiyGuide</simpleValue></propertySet>
          <baseName><simpleValue>partId</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
