        </attribute>
        <property cardinality="required">
          <propertySet><simpleValue>Pset_DiyGuide</simpleValue></propertySet>
          <baseName><simpleValue>partId</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Expected IfcFurniture products" ifcVersion="IFC4X3_ADD2">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IfcFurniture</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
