          <name><simpleValue>IfcPlate</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name><simpleValue>GlobalId</simpleValue></name>
        </attribute>
        <property cardinality="required">
